# Turso / libSQL database connection (required in production / on Netlify).
# Create with: turso db create weather-starter
#   turso db show weather-starter --url      -> TURSO_DATABASE_URL (libsql://...)
#   turso db tokens create weather-starter   -> TURSO_AUTH_TOKEN (eyJ...)
# When unset, db.ts falls back to a local file URL for tests/dev.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional data.gov.sg API key for higher rate limits.
# The app works without this for light local usage.
WEATHER_API_KEY=

# Stable local browser URL used by scripts/dev.mjs through Portless.
PORTLESS_PORT=1355
PORTLESS_HTTPS=0
